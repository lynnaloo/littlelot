# The Little Lot — environment variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# landrecords.us API key — get this from Travis / landrecords.us dashboard
LANDRECORDS_API_KEY=b90f2938-58e0-47fd-a8c4-676b16be86e0

# Base URL for the landrecords.us API
LANDRECORDS_API_BASE_URL=https://api.landrecords.us

# Mapbox/MapLibre tile style (optional — defaults to a free OSM style)
# NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# App URL (used for absolute URLs in metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
